+// ---------------------------------------------------------------------------
+// Image-map per-layer color rotation: outer-wall modulation.
+// Ported from OrcaSlicer-ImageMap
+// (https://github.com/sentientstardust-dev/OrcaSlicer-ImageMap, release
+// v1.0.22, commit 92548381056dbf72836b0a1bdc455f238218dbfb), GCode.cpp outer
+// wall gradient path (lines ~10860-11180 of origin) and
+// TextureMappingOffset.cpp component_weights_for_sample().
+//
+// Adaptation: the origin samples an image texture per path *segment*, so it
+// displaces each segment's endpoints individually inside its G-code emission
+// loop. Here the colour target of a painted region is constant, so the solver
+// weight — and therefore both the modulated width and the centerline shift —
+// is constant along a whole external perimeter loop. That lets the shift be
+// applied once, as a miter offset of the closed loop, before seam placement
+// and scarf-seam construction ever see the geometry. Per-segment image
+// sampling, dithering and halftoning remain Phase 3 scope.
+// ---------------------------------------------------------------------------
+
+void GCode::init_image_map_per_layer_color(const Print &print)
+{
+    m_image_map_modulation_enabled = false;
+    if (!ImageMapPerLayer::enabled(print.config()))
+        return; // default OFF — strict no-op
+    // Read the rotation set ToolOrdering already computed (Print::process()
+    // runs before do_export(), so print.tool_ordering() is populated by now)
+    // instead of independently recomputing it here: ToolOrdering derives the
+    // set from real per-layer extruder usage, not just Print-level config, so
+    // recomputing separately risked silently disagreeing with (or being more
+    // permissive than) the tool-change collapsing this modulation must track.
+    const std::vector<unsigned int> &rotation = print.tool_ordering().image_map_rotation_filaments();
+    if (rotation.size() < 2)
+        return;
+    if (!m_image_map_solver.init(print.config(), rotation))
+        return;
+    m_image_map_modulation_enabled = true;
+}
+
+bool GCode::image_map_modulate_outer_wall_loop(ExtrusionLoop &loop)
+{
+    if (!m_image_map_modulation_enabled)
+        return false; // default OFF — strict no-op
+    if (loop.role() != erExternalPerimeter)
+        return false;
+    if (loop.paths.empty() || m_writer.filament() == nullptr)
+        return false;
+    // Overhang paths inside an external loop are bridged/unsupported material
+    // with their own flow and speed handling. They would have to move with the
+    // rest of the ring to keep it connected, but re-widthing them is not safe,
+    // and shifting them without re-widthing would push them into the wall
+    // behind. Leave such loops entirely alone.
+    if (loop.has_overhang_paths())
+        return false;
+    for (const ExtrusionPath &path : loop.paths) {
+        if (path.role() != erExternalPerimeter || path.is_force_no_extrusion())
+            return false;
+        if (path.polyline.points.size() < 2)
+            return false;
+    }
+    // The ring must actually close for the flatten/offset/write-back below to
+    // preserve connectivity.
+    {
+        const Point &ring_end   = loop.paths.back().last_point();
+        const Point &ring_start = loop.paths.front().first_point();
+        if (ring_end.x() != ring_start.x() || ring_end.y() != ring_start.y())
+            return false;
+    }
+    // Likewise every interior junction must be exact, or writing the offset
+    // vertices back would tear the ring apart.
+    for (size_t p = 0; p + 1 < loop.paths.size(); ++p) {
+        const Point &a = loop.paths[p].last_point();
+        const Point &b = loop.paths[p + 1].first_point();
+        if (a.x() != b.x() || a.y() != b.y())
+            return false;
+    }
+    // A single width for the whole ring keeps the centerline shift constant,
+    // which is what makes the one-shot miter offset valid.
+    const float nominal_width = loop.paths.front().width;
+    if (nominal_width <= EPSILON)
+        return false;
+    for (const ExtrusionPath &path : loop.paths)
+        if (std::abs(path.width - nominal_width) > 1e-4f)
+            return false;
+
+    // extrude_perimeters() applies the region config into m_config before
+    // extruding, so wall_filament here is the painted region's original
+    // filament — the color target (same mechanism the origin feature used).
+    const int target_filament = m_config.wall_filament.value - 1;
+    if (target_filament < 0)
+        return false;
+    const unsigned int active_filament = m_writer.filament()->id();
+    const float weight = m_image_map_solver.weight_for(unsigned(target_filament), active_filament);
+    if (weight < 0.f)
+        return false; // active or target filament outside the rotation set
+
+    const float layer_height = loop.paths.front().height > EPSILON ? loop.paths.front().height :
+        float(m_layer != nullptr ? m_layer->height : m_last_height);
+    const float nozzle_diameter = float(EXTRUDER_CONFIG(nozzle_diameter));
+    const auto mode = m_config.image_map_outer_wall_mode.value == 1 ?
+        ImageMapPerLayer::OuterWallMode::Centered :
+        ImageMapPerLayer::OuterWallMode::Inward;
+
+    const ImageMapPerLayer::WallModulation modulation = ImageMapPerLayer::compute_wall_modulation(
+        weight,
+        nominal_width,
+        float(m_config.texture_mapping_outer_wall_gradient_min_line_width.value),
+        float(m_config.texture_mapping_outer_wall_gradient_max_line_width.value),
+        float(m_config.texture_mapping_outer_wall_gradient_global_strength.value),
+        layer_height,
+        nozzle_diameter,
+        mode);
+    if (!modulation.active)
+        return false;
+
+    // Flatten the loop into one ring of vertices. Consecutive paths share an
+    // endpoint, so each path contributes all but its last point; the last path's
+    // last point is the first path's first point.
+    Points ring;
+    std::vector<size_t> path_start;
+    path_start.reserve(loop.paths.size());
+    for (const ExtrusionPath &path : loop.paths) {
+        path_start.emplace_back(ring.size());
+        const Points &pts = path.polyline.points;
+        ring.insert(ring.end(), pts.begin(), pts.end() - 1);
+    }
+    if (ring.size() < 3)
+        return false;
+
+    // ImageMapPerLayer::offset_closed_ring() offsets toward the ring's own
+    // interior. For a hole the model's material is *outside* the ring, so the
+    // "toward the material" shift has to be negated.
+    const bool is_hole = (loop.loop_role() & elrPerimeterHole) != 0;
+    double delta = scale_(double(modulation.centerline_shift_mm));
+    if (is_hole)
+        delta = -delta;
+
+    Points offset_ring;
+    if (!ImageMapPerLayer::offset_closed_ring(ring, delta, offset_ring))
+        return false; // degenerate/self-intersecting: leave the loop untouched
+    if (offset_ring.size() != ring.size())
+        return false;
+
+    // Write the offset vertices back, keeping every path's point count and the
+    // shared endpoints consistent.
+    const size_t n = ring.size();
+    for (size_t p = 0; p < loop.paths.size(); ++p) {
+        Points &pts = loop.paths[p].polyline.points;
+        for (size_t i = 0; i < pts.size(); ++i)
+            pts[i] = offset_ring[(path_start[p] + i) % n];
+        loop.paths[p].width = modulation.width_mm;
+        loop.paths[p].mm3_per_mm *= modulation.flow_scale;
+    }
+    return true;
+}
