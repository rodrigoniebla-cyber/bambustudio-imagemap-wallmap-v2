diff --git a/src/slic3r/GUI/ConfigManipulation.cpp b/src/slic3r/GUI/ConfigManipulation.cpp
index b9609b3..04ad0ba 100644
--- a/src/slic3r/GUI/ConfigManipulation.cpp
+++ b/src/slic3r/GUI/ConfigManipulation.cpp
@@ -1118,6 +1118,27 @@ void ConfigManipulation::toggle_print_fff_options(DynamicPrintConfig *config, in
 
     std::string printer_type = wxGetApp().preset_bundle->printers.get_edited_preset().get_printer_type(wxGetApp().preset_bundle);
     toggle_line("enable_wrapping_detection", DevPrinterConfigUtil::support_wrapping_detection(printer_type));
+
+    // Image map per-layer color: nothing under the master toggle does anything
+    // until it is on, and the wall map's three toggles are arranged so that only
+    // the settings that currently matter are editable. "Combined" is the fixed
+    // preset, so it takes over both halves and greys out everything they own.
+    bool image_map_on       = config->opt_bool("image_map_per_layer_color_rotation");
+    bool image_map_combined = image_map_on && config->opt_bool("image_map_wall_combined_preset");
+    bool image_map_width    = image_map_on && !image_map_combined && config->opt_bool("image_map_wall_width_enable");
+    bool image_map_offset   = image_map_on && !image_map_combined && config->opt_bool("image_map_wall_offset_enable");
+    for (auto el : { "image_map_wall_combined_preset", "image_map_generic_solver_lookup_mode",
+                     "image_map_generic_solver_mode", "image_map_generic_solver_mix_model" })
+        toggle_field(el, image_map_on);
+    for (auto el : { "image_map_wall_width_enable", "image_map_wall_offset_enable" })
+        toggle_field(el, image_map_on && !image_map_combined);
+    for (auto el : { "image_map_wall_width_allow_widening",
+                     "texture_mapping_outer_wall_gradient_global_strength",
+                     "texture_mapping_outer_wall_gradient_min_line_width",
+                     "texture_mapping_outer_wall_gradient_max_line_width" })
+        toggle_field(el, image_map_width);
+    for (auto el : { "image_map_wall_offset_distance", "image_map_wall_offset_direction" })
+        toggle_field(el, image_map_offset);
 }
 
 void ConfigManipulation::update_print_sla_config(DynamicPrintConfig* config, const bool is_global_config/* = false*/)
